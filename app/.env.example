# Firebase (frontend Vite env vars)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local Firebase emulator toggle (optional)
# VITE_FIREBASE_EMULATOR=true

# Cloudinary - required by the frontend for generating optimized image URLs
VITE_CLOUDINARY_CLOUD_NAME=

# Cloudinary - required only by the migration/upload scripts (never shipped to the browser)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Cloudflare Stream - required only by the migration/upload scripts
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Base URL for static assets (useful for GitHub Pages deploys)
VITE_ASSET_BASE_URL=/
